#!/usr/bin/env bash
# .githooks/pre-commit
#
# Auto-syncs agents/ and skills/ mirrors with .claude/agents/ and .claude/skills/.
# If any files are updated, they are staged automatically before the commit proceeds.
#
# Install once per machine:
#   git config core.hooksPath .githooks
#
# To bypass in an emergency (not recommended):
#   git commit --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if bash "$REPO_ROOT/scripts/sync-agents-skills.sh" --check > /dev/null 2>&1; then
  # Already in sync — nothing to do
  exit 0
fi

# Out of sync — auto-sync and stage
echo "Auto-syncing agents/ and skills/ mirrors..."
bash "$REPO_ROOT/scripts/sync-agents-skills.sh"
git -C "$REPO_ROOT" add agents/ skills/
echo "Mirrors synced and staged automatically."
