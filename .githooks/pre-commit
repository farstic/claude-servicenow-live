#!/usr/bin/env bash
# .githooks/pre-commit
#
# Blocks commits when agents/ or skills/ mirrors are out of sync with
# .claude/agents/ and .claude/skills/.
#
# Install once per machine:
#   git config core.hooksPath .githooks
#
# To bypass in an emergency (not recommended):
#   git commit --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if bash "$REPO_ROOT/scripts/sync-agents-skills.sh" --check; then
  exit 0
else
  echo ""
  echo "Pre-commit blocked: agents/ or skills/ mirrors are out of sync."
  echo "Run the following to fix and re-stage:"
  echo ""
  echo "  bash scripts/sync-agents-skills.sh"
  echo "  git add agents/ skills/"
  echo ""
  exit 1
fi
