        <mxCell id="gate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C92A2A;strokeColor=#7A1212;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="§1.1 BASELINE-FIRST GATE — a custom table / scoped app / state extension / new group requires an explicit, separate user approval. Self-authorization is prohibited; otherwise HALT and produce no artefact." vertex="1">
          <mxGeometry height="40" width="1096" x="32" y="210" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#1C7ED6;fontColor=#0B3D91;fontSize=11;" value="PHASE 1 — Routing-time evaluation  (taxonomy §6.1)&#xa;&#xa;1  Restate the task in one sentence&#xa;2  Read engagement state (clients/&lt;name&gt;/...)&#xa;3  Surface assumptions &amp; OPEN QUESTIONs&#xa;4  Evaluate §1.1 custom-object implications&#xa;5  Domain Expert GATEWAY → 5-Part Constraint Envelope&#xa;6  Resolve routing ambiguity (taxonomy.md)&#xa;7  Flag §3.1 routing-time consults&#xa;8–9  Propose the specialist + await approval&#xa;10  Dispatch via Task tool with the Envelope" vertex="1">
          <mxGeometry height="180" width="540" x="32" y="258" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#1C7ED6;fontColor=#0B3D91;fontSize=11;" value="PHASE 2 — Post-build evaluation  (taxonomy §6.2)&#xa;&#xa;1  Hold the artefact — do not present yet&#xa;2  Classify content (code / flow / config / design)&#xa;3  Scan for §1.1 violations (new table/scope/state)&#xa;4  Domain Expert RE-FIRES in review mode&#xa;5  Post-build consults: Code Reviewer · ATF · Op Docs · Diagramming&#xa;6–7  Present artefact + consult proposals; await decisions&#xa;8  Adopt Code Reviewer (main thread); run 4 checklists&#xa;9  On REWORK → re-dispatch the originating builder" vertex="1">
          <mxGeometry height="180" width="540" x="588" y="258" as="geometry" />
        </mxCell>
        <mxCell id="eAg" edge="1" parent="1" source="arch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#1F3864;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="gate" value="every task">
