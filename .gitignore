clients/
deliverables/
.backups/
claude-ai-projects/
.env
start-mcp.sh

# Audit / internal reports — may quote live instance data (URLs, sys_ids). Local-only, never pushed.
reports/

# Machine-specific Claude Code settings (contain absolute local paths and per-user permissions)
.claude/settings.json
.claude/settings.local.json

# A project-scoped MCP registration is not part of this repository: the snowarch checkout carries its own
# secret-free .mcp.json, and credentials live only in that checkout's .local/instances.json. A file with this
# name here is a leftover of the previous tooling (which stored the instance URL and password in it). NEVER commit.
.mcp.json

# Scratch snowarch example — hardcodes the live instance URL (instance values are local-only per the Standing Rule).
snowarch-example.ts

# Editor workspace settings — machine-specific.
.vscode/

# Local rendered diagram previews (SVGs/HTML) — scratch viewing only, regenerable from .mmd.
diagram-preview/
