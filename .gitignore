clients/
deliverables/
.backups/
claude-ai-projects/
.env
start-mcp.sh

# Audit / internal reports — may quote live instance data (URLs, sys_ids). Local-only, never pushed.
reports/

# Machine-specific Claude Code settings (contain absolute local paths and per-user permissions)
.claude/settings.json
.claude/settings.local.json

# Local MCP server config — contains the live instance URL and a PLAINTEXT password. NEVER commit.
# The trailing * covers .bak copies, which carry the same password.
.mcp.json*

# Scratch nowaikit example — hardcodes the live instance URL (instance values are local-only per the Standing Rule).
nowaikit-example.ts

# Editor workspace settings — machine-specific.
.vscode/

# Local rendered diagram previews (SVGs/HTML) — scratch viewing only, regenerable from .mmd.
diagram-preview/

# Product build-progress notes — quote live instance data (URLs, sys_ids, usernames). Local-only per the Standing Rule.
products/**/build/*PROGRESS*.md

# Multi-instance MCP config � contains PLAINTEXT passwords for every instance. NEVER commit.
instances.json
# ...and any backup of it - a .bak carries the same plaintext passwords
instances.json*

# stray MCP config holding a plaintext ServiceNow password — never commit
mcp.json
